    <actions>
        <group id="com.craftzdog.solarizedosaka.Menu" text="Solarized Osaka" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
        </group>
        <action id="com.craftzdog.solarizedosaka.UsageGuide"
                class="com.craftzdog.solarizedosaka.actions.OsakaUsageGuideAction"
                text="Solarized Osaka Usage Guide" description="Read the installation and customization guide">
            <add-to-group group-id="HelpMenu" anchor="last"/>
            <add-to-group group-id="com.craftzdog.solarizedosaka.Menu" anchor="first"/>
        </action>
        <action id="com.craftzdog.solarizedosaka.Changelog"
                class="com.craftzdog.solarizedosaka.actions.OsakaChangelogAction"
                text="Solarized Osaka Changelog" description="Read the changes by release">
            <add-to-group group-id="HelpMenu" anchor="last"/>
            <add-to-group group-id="com.craftzdog.solarizedosaka.Menu" anchor="after"
                          relative-to-action="com.craftzdog.solarizedosaka.UsageGuide"/>
        </action>
        <action id="com.craftzdog.solarizedosaka.ExportSyntaxBundles"
                class="com.craftzdog.solarizedosaka.actions.ExportSyntaxBundlesAction"
                text="Export Solarized Osaka Syntax Bundles" description="Save the optional starter TextMate grammars">
            <add-to-group group-id="com.craftzdog.solarizedosaka.Menu" anchor="last"/>
        </action>
        <action id="com.craftzdog.solarizedosaka.UndoPaletteApply" class="com.craftzdog.solarizedosaka.actions.UndoPaletteApplyAction"
                text="Undo Last Solarized Osaka Apply" description="Restore the previous theme and editor colors">
            <add-to-group group-id="com.craftzdog.solarizedosaka.Menu" anchor="last"/>
        </action>
        <action id="com.craftzdog.solarizedosaka.QuickPalette" class="com.craftzdog.solarizedosaka.actions.QuickPaletteAction"
                text="Switch Solarized Osaka Palette" description="Open favorite and recent Solarized Osaka palettes">
            <add-to-group group-id="com.craftzdog.solarizedosaka.Menu" anchor="last"/>
        </action>
        <action id="com.craftzdog.solarizedosaka.Customize" class="com.craftzdog.solarizedosaka.actions.CustomizeAction" text="Customize Solarized Osaka…" description="Create a personal theme from a Solarized Osaka preset">
            <add-to-group group-id="com.craftzdog.solarizedosaka.Menu" anchor="last"/>
        </action>
        <action id="com.craftzdog.solarizedosaka.OpenThemeGallery"
                class="com.craftzdog.solarizedosaka.actions.OpenThemeGalleryAction"
                text="Solarized Osaka Theme Gallery"
                description="Browse Solarized Osaka palette families and previews">
            <add-to-group group-id="com.craftzdog.solarizedosaka.Menu" anchor="last"/>
        </action>
        <action id="com.craftzdog.solarizedosaka.SwitchBrightness" class="com.craftzdog.solarizedosaka.actions.SwitchOsakaBrightnessAction" text="Switch Solarized Osaka Dark/Light" description="Switch to the matching Solarized Osaka brightness variant">
            <add-to-group group-id="com.craftzdog.solarizedosaka.Menu" anchor="last" />
        </action>
        <action id="com.craftzdog.solarizedosaka.SaveProjectTheme" class="com.craftzdog.solarizedosaka.actions.SaveProjectThemeAction" text="Save Solarized Osaka Theme for Project" description="Save the current UI theme and editor scheme for this project">
            <add-to-group group-id="com.craftzdog.solarizedosaka.Menu" anchor="last" />
        </action>
        <action id="com.craftzdog.solarizedosaka.ApplyProjectTheme" class="com.craftzdog.solarizedosaka.actions.ApplyProjectThemeAction" text="Apply Saved Theme and Project Editor Scheme" description="Apply the saved UI theme IDE-wide and editor scheme to this project's editors">
            <add-to-group group-id="com.craftzdog.solarizedosaka.Menu" anchor="last" />
        </action>
        <action id="com.craftzdog.solarizedosaka.OpenPreview" class="com.craftzdog.solarizedosaka.actions.OpenOsakaPreviewAction" text="Open Solarized Osaka Preview" description="Open sample files for previewing Solarized Osaka colors">
            <add-to-group group-id="com.craftzdog.solarizedosaka.Menu" anchor="last" />
        </action>
    </actions>
</idea-plugin>
