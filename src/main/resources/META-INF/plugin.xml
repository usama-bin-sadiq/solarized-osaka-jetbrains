        <bundledColorScheme id="Solarized Osaka Teal Accent Light" path="/themes/SolarizedOsakaTealAccentLight.xml" />
        <bundledColorScheme id="Solarized Osaka Purple Accent" path="/themes/SolarizedOsakaPurpleAccent.xml" />
        <bundledColorScheme id="Solarized Osaka Purple Accent Light" path="/themes/SolarizedOsakaPurpleAccentLight.xml" />
