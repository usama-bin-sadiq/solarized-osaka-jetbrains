<?xml version='1.0' encoding='UTF-8'?>
<idea-plugin>
    <id>com.craftzdog.solarizedosaka</id>
    <name>Solarized Osaka</name>
    <version>1.7.2</version>
    <vendor url="https://github.com/craftzdog/solarized-osaka.nvim">craftzdog inspired</vendor>
    <description><![CDATA[
        <h2>Solarized Osaka for JetBrains IDEs</h2>
        <p>48 Classic and Islands UI themes across 12 Solarized Osaka palette families.</p>
        <p>Includes a theme gallery, language-aware editor colors, custom language token mappings, VCS and console palettes, font presets, preview samples, and optional system appearance sync.</p>
        <p>Compatible with IntelliJ Platform build 243 and newer. Islands variants require Islands UI support.</p>
        <p>Inspired by <a href="https://github.com/craftzdog/solarized-osaka.nvim">solarized-osaka.nvim</a> by craftzdog.</p>
    ]]></description>
    <idea-version since-build="243" />
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="SolarizedOsakaWelcome" displayType="BALLOON" isLogByDefault="false"/>
        <postStartupActivity implementation="com.craftzdog.solarizedosaka.OsakaStartupActivity"/>
        <themeProvider id="com.craftzdog.solarizedosaka.dark" path="/themes/SolarizedOsaka.theme.json" />
        <themeProvider id="com.craftzdog.solarizedosaka.light" path="/themes/SolarizedOsakaLight.theme.json" />
        <themeProvider id="com.craftzdog.solarizedosaka.islands.dark" path="/themes/SolarizedOsakaIslands.theme.json" targetUi="islands" />
        <themeProvider id="com.craftzdog.solarizedosaka.islands.light" path="/themes/SolarizedOsakaIslandsLight.theme.json" targetUi="islands" />
        <themeProvider id="com.craftzdog.solarizedosaka.variant.oled" path="/themes/SolarizedOsakaOLED.theme.json" />
        <themeProvider id="com.craftzdog.solarizedosaka.variant.high-contrast" path="/themes/SolarizedOsakaHighContrast.theme.json" />
