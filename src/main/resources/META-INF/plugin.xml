        <themeProvider id="com.craftzdog.solarizedosaka.quadrant.vivid-light" path="/themes/SolarizedOsakaVividLight.theme.json" />
        <themeProvider id="com.craftzdog.solarizedosaka.quadrant.vivid-light.islands" path="/themes/SolarizedOsakaIslandsVividLight.theme.json" targetUi="islands" />
        <themeProvider id="com.craftzdog.solarizedosaka.quadrant.muted" path="/themes/SolarizedOsakaMuted.theme.json" />
        <themeProvider id="com.craftzdog.solarizedosaka.quadrant.muted.islands" path="/themes/SolarizedOsakaIslandsMuted.theme.json" targetUi="islands" />
        <themeProvider id="com.craftzdog.solarizedosaka.quadrant.muted-light" path="/themes/SolarizedOsakaMutedLight.theme.json" />
        <themeProvider id="com.craftzdog.solarizedosaka.quadrant.muted-light.islands" path="/themes/SolarizedOsakaIslandsMutedLight.theme.json" targetUi="islands" />
