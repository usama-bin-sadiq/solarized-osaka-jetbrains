        <bundledColorScheme id="Solarized Osaka Quiet UI Light" path="/themes/SolarizedOsakaQuietUILight.xml" />
        <bundledColorScheme id="Solarized Osaka Vivid" path="/themes/SolarizedOsakaVivid.xml" />
        <bundledColorScheme id="Solarized Osaka Vivid Light" path="/themes/SolarizedOsakaVividLight.xml" />
        <bundledColorScheme id="Solarized Osaka Muted" path="/themes/SolarizedOsakaMuted.xml" />
        <bundledColorScheme id="Solarized Osaka Muted Light" path="/themes/SolarizedOsakaMutedLight.xml" />
        <themeProvider id="com.craftzdog.solarizedosaka.variant.islands.dimmed" path="/themes/SolarizedOsakaIslandsDimmed.theme.json" targetUi="islands" />
        <themeProvider id="com.craftzdog.solarizedosaka.variant.islands.warm-light" path="/themes/SolarizedOsakaIslandsWarmLight.theme.json" targetUi="islands" />
        <themeProvider id="com.craftzdog.solarizedosaka.variant.islands.teal-accent" path="/themes/SolarizedOsakaIslandsTealAccent.theme.json" targetUi="islands" />
