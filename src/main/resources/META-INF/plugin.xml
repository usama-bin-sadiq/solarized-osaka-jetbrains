        <bundledColorScheme id="Solarized Osaka Warm Dark" path="/themes/SolarizedOsakaWarmDark.xml" />
        <applicationConfigurable id="com.craftzdog.solarizedosaka.themeGallery" parentId="appearance" instance="com.craftzdog.solarizedosaka.settings.ThemeGalleryConfigurable" displayName="Solarized Osaka Theme Gallery"/>
        <applicationConfigurable id="com.craftzdog.solarizedosaka.languageColors" parentId="editor" instance="com.craftzdog.solarizedosaka.settings.LanguageMappingsConfigurable" displayName="Solarized Osaka Language Colors"/>
