        <themeProvider id="com.craftzdog.solarizedosaka.quadrant.dimmed-light" path="/themes/SolarizedOsakaDimmedLight.theme.json" />
        <themeProvider id="com.craftzdog.solarizedosaka.quadrant.dimmed-light.islands" path="/themes/SolarizedOsakaIslandsDimmedLight.theme.json" targetUi="islands" />
        <themeProvider id="com.craftzdog.solarizedosaka.quadrant.warm-dark" path="/themes/SolarizedOsakaWarmDark.theme.json" />
        <themeProvider id="com.craftzdog.solarizedosaka.quadrant.warm-dark.islands" path="/themes/SolarizedOsakaIslandsWarmDark.theme.json" targetUi="islands" />
        <themeProvider id="com.craftzdog.solarizedosaka.quadrant.vivid" path="/themes/SolarizedOsakaVivid.theme.json" />
