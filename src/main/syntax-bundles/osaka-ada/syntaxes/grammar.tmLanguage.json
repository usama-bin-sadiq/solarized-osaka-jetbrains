{
  "name": "Ada (Solarized Osaka starter)",
  "scopeName": "source.osaka-ada",
  "patterns": [
    {
      "name": "comment.line.ada",
      "match": "\\-\\-.*$"
    },
    {
      "name": "string.quoted.double.ada",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.ada"
        }
      ]
    },
    {
      "name": "keyword.control.ada",
      "match": "(?i)\\b(?:abort|abs|abstract|accept|access|aliased|all|and|array|at|begin|body|case|constant|declare|delay|delta|digits|do|else|elsif|end|entry|exception|exit|for|function|generic|goto|if|in|is|limited|loop|mod|new|not|null|of|or|others|out|package|pragma|private|procedure|protected|raise|range|record|rem|renames|requeue|return|reverse|select|separate|subtype|tagged|task|terminate|then|type|until|use|when|while|with|xor)\\b"
    },
    {
      "name": "constant.language.ada",
      "match": "(?i)\\b(?:true|false|null)\\b"
    },
    {
      "name": "storage.type.ada",
      "match": "(?i)\\b(?:integer|natural|positive|boolean|float|character|string|duration)\\b"
    },
    {
      "name": "constant.numeric.ada",
      "match": "\\b(?:0[xX][0-9a-fA-F_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?)\\b"
    }
  ]
}
