{
  "name": "Nim (Solarized Osaka starter)",
  "scopeName": "source.osaka-nim",
  "patterns": [
    {
      "name": "comment.block.nim",
      "begin": "\\#\\[",
      "end": "\\]\\#"
    },
    {
      "name": "comment.line.nim",
      "match": "\\#.*$"
    },
    {
      "name": "string.quoted.double.nim",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.nim"
        }
      ]
    },
    {
      "name": "keyword.control.nim",
      "match": "\\b(?:addr|and|as|asm|bind|block|break|case|cast|concept|const|continue|converter|defer|discard|distinct|div|do|elif|else|end|enum|except|export|finally|for|from|func|if|import|in|include|interface|iterator|let|macro|method|mixin|mod|nil|not|object|of|or|out|proc|ptr|raise|ref|return|static|template|try|tuple|type|using|var|when|while|yield)\\b"
    },
    {
      "name": "constant.language.nim",
      "match": "\\b(?:true|false|nil)\\b"
    },
    {
      "name": "storage.type.nim",
      "match": "\\b(?:int|uint|string|bool|float|char|seq|openArray)\\b"
    },
    {
      "name": "constant.numeric.nim",
      "match": "\\b(?:0[xX][0-9a-fA-F_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?)\\b"
    }
  ]
}
